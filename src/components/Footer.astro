---
import { localePath, type LanguageCode, type LocalizedText } from '../i18n';

interface Props {
  locale: LanguageCode;
  text: LocalizedText;
}

const { locale, text } = Astro.props;
const YOMILAB_GITHUB_URL = 'https://github.com/yomilab';
---

<footer class="site-footer shell">
  <div class="footer-note">
    <span class="footer-tagline">{text.footer.brandTagline}</span>
    <span>{text.footer.disclaimer}</span>
  </div>
  <nav class="footer-nav" aria-label={text.nav.aria}>
    <a href={localePath(locale, '/download/')}>{text.nav.download}</a>
    <a href={localePath(locale, '/resource/')}>{text.footer.resource}</a>
    <a href={localePath(locale, '/changelog/')}>{text.nav.changelog}</a>
    <a href="/feed.xml">{text.nav.rss}</a>
    <a href={localePath(locale, '/privacy/')}>{text.footer.privacy}</a>
    <a href={localePath(locale, '/support/')}>{text.footer.support}</a>
    <a href="/llms.txt">{text.footer.llms}</a>
    <a href={YOMILAB_GITHUB_URL} target="_blank" rel="noreferrer">
      <svg class="github-icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 2C6.48 2 2 6.58 2 12.24c0 4.52 2.87 8.35 6.84 9.7.5.1.68-.22.68-.49v-1.72c-2.78.62-3.37-1.38-3.37-1.38-.45-1.18-1.11-1.49-1.11-1.49-.91-.64.07-.62.07-.62 1 .07 1.53 1.06 1.53 1.06.9 1.57 2.35 1.12 2.92.86.09-.67.35-1.12.64-1.38-2.22-.26-4.55-1.14-4.55-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05A9.36 9.36 0 0 1 12 6.96c.85 0 1.7.12 2.5.35 1.9-1.33 2.74-1.05 2.74-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.93-2.34 4.8-4.57 5.05.36.32.68.94.68 1.9v2.78c0 .27.18.59.69.49A10.18 10.18 0 0 0 22 12.24C22 6.58 17.52 2 12 2Z"></path>
      </svg>
      <span>{text.footer.github}</span>
    </a>
  </nav>
</footer>
