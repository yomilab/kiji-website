---
import { LANGUAGE_OPTIONS, localePath, type LanguageCode, type LocalizedText } from '../i18n';

interface Props {
  locale: LanguageCode;
  text: LocalizedText['language'];
  canonicalPath: string;
}

const { locale, text, canonicalPath } = Astro.props;
const selectedOption = LANGUAGE_OPTIONS.find((option) => option.code === locale) ?? LANGUAGE_OPTIONS[0];
---

<details class="language-menu">
  <summary class="language-trigger" aria-label={`${text.triggerAria}: ${selectedOption.shortLabel}`}>
    <svg class="language-icon" viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="12" cy="12" r="9"></circle>
      <path d="M3 12h18"></path>
      <path d="M12 3c2.4 2.4 3.6 5.4 3.6 9s-1.2 6.6-3.6 9c-2.4-2.4-3.6-5.4-3.6-9S9.6 5.4 12 3Z"></path>
    </svg>
    <span class="language-short">{selectedOption.shortLabel}</span>
  </summary>
  <div class="language-options">
    {LANGUAGE_OPTIONS.map((option) => (
      <a
        class={option.code === locale ? 'language-option active' : 'language-option'}
        href={localePath(option.code, canonicalPath)}
        hreflang={option.code}
        data-language-choice={option.code}
        aria-current={option.code === locale ? 'true' : undefined}
        aria-label={`${text.setAria} ${option.shortLabel}`}
      >
        <span>{option.shortLabel}</span>
      </a>
    ))}
  </div>
</details>
