---
import Base from '../../layouts/Base.astro';
import { getText, localePath, type LanguageCode } from '../../i18n';

interface Props {
  locale: LanguageCode;
}

const { locale } = Astro.props;
const text = getText(locale);

const canonicalUrl = new URL(
  localePath(locale, '/privacy/'),
  Astro.site ?? 'https://kiji.yomilab.app'
).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: text.pageMeta.privacy.title,
  description: text.pageMeta.privacy.description,
  url: canonicalUrl,
  inLanguage: locale,
};
---

<Base page="privacy" locale={locale} text={text} jsonLd={jsonLd}>
  <main class="shell hero">
    <p class="eyebrow">{text.privacy.eyebrow}</p>
    <h1>{text.privacy.title}</h1>
    <p class="lead">{text.privacy.lead}</p>
  </main>
</Base>
