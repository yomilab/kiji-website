---
import Base from '../../layouts/Base.astro';
import { getText, localePath, type LanguageCode } from '../../i18n';

interface Props {
  locale: LanguageCode;
}

const { locale } = Astro.props;
const text = getText(locale);

const canonicalUrl = new URL(
  localePath(locale, '/privacy/'),
  Astro.site ?? 'https://reader.yomilab.app'
).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: text.pageMeta.privacy.title,
  description: text.pageMeta.privacy.description,
  url: canonicalUrl,
  inLanguage: locale,
};
---

<Base page="privacy" locale={locale} text={text} jsonLd={jsonLd}>
  <main class="shell hero">
    <p class="eyebrow">{text.privacy.eyebrow}</p>
    <h1>{text.privacy.title}</h1>
    <p class="lead">{text.privacy.lead}</p>
    <section class="doc-section" id="assistant-access" aria-labelledby="assistant-access-title">
      <h2 id="assistant-access-title">{text.privacy.assistantTitle}</h2>
      <p>{text.privacy.assistantLead}</p>
      <ul class="doc-points">
        {text.privacy.assistantPoints.map((point) => (
          <li><strong>{point.title}</strong> {point.text}</li>
        ))}
      </ul>
      <a class="doc-link" href={localePath(locale, '/assistant/')}>{text.privacy.assistantHelpLink}</a>
    </section>
    <section class="doc-section" id="app-updates" aria-labelledby="app-updates-title">
      <h2 id="app-updates-title">{text.privacy.updatesTitle}</h2>
      <p>{text.privacy.updatesText}</p>
    </section>
  </main>
</Base>
