---
import Base from '../../layouts/Base.astro';
import { getText, localePath, type LanguageCode } from '../../i18n';
import releasesData from '../../data/releases.json';
import { releaseNotesFor, type ReleaseEntry } from '../../lib/release';

interface Props {
  locale: LanguageCode;
}

const { locale } = Astro.props;
const text = getText(locale);
const releases = (releasesData as ReleaseEntry[]).filter((entry) => entry.version);
const dateFormatter = new Intl.DateTimeFormat(locale, { dateStyle: 'long' });

const canonicalUrl = new URL(
  localePath(locale, '/changelog/'),
  Astro.site ?? 'https://kiji.yomilab.app'
).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: text.pageMeta.changelog.title,
  url: canonicalUrl,
  itemListElement: releases.map((release, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: `KiJi ${release.version}`,
    url: `${canonicalUrl}#${release.tag ?? `v${release.version}`}`,
  })),
};
---

<Base page="changelog" locale={locale} text={text} jsonLd={jsonLd}>
  <main class="shell hero">
    <p class="eyebrow">{text.changelog.eyebrow}</p>
    <h1>{text.changelog.title}</h1>
    <p class="lead">{text.changelog.lead}</p>
    <div class="actions">
      <a class="button" href="/feed.xml">{text.changelog.rssCta}</a>
    </div>
    <ul class="release-list">
      {releases.map((release) => {
        const assetsUrl = release.assetsUrl;
        const notes = releaseNotesFor(release.notes, locale);
        const sections = notes?.sections ?? [];
        return (
          <li class="release-item" id={release.tag ?? `v${release.version}`} lang={notes === release.notes ? 'en' : undefined}>
            <div class="release-heading">
              <h2>KiJi {release.version}</h2>
              {release.date && <time datetime={release.date}>{dateFormatter.format(new Date(release.date))}</time>}
            </div>
            {notes?.summary && <p class="release-summary">{notes.summary}</p>}
            {sections.map((section) => (
              <section class="release-notes-group">
                <h3>{section.title}</h3>
                <ul>
                  {section.items.map((item) => <li>{item}</li>)}
                </ul>
              </section>
            ))}
            {assetsUrl && (
              <a class="release-notes-link" href={assetsUrl} target="_blank" rel="noreferrer">
                {text.changelog.assetsLink}
              </a>
            )}
          </li>
        );
      })}
    </ul>
  </main>
</Base>
