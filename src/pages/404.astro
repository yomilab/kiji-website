---
import Base from '../layouts/Base.astro';
import { getText } from '../i18n';

const text = getText('en');
---

<Base
  page="home"
  locale="en"
  text={text}
  metaTitle="Page not found - Yomi Reader"
  metaDescription="The requested Yomi Reader website page could not be found."
  noindex
>
  <main class="shell hero">
    <p class="eyebrow">404</p>
    <h1>Page not found.</h1>
    <div class="actions">
      <a class="button primary" href="/">Back to Yomi Reader home</a>
    </div>
  </main>
</Base>
