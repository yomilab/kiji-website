---
import '../styles.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import {
  DEFAULT_LANGUAGE_CODE,
  LANGUAGE_OPTIONS,
  LANGUAGE_STORAGE_KEY,
  OG_LOCALES,
  localePath,
  type LanguageCode,
  type LocalizedText,
  type PageKey,
} from '../i18n';
import { formatVersionedCopy } from '../lib/release';
import { DEFAULT_SITE_THEME, SITE_THEME_STORAGE_KEY, THEME_IDS, readerThemeCss } from '../lib/readerThemes';

interface Props {
  page: PageKey;
  locale: LanguageCode;
  text: LocalizedText;
  releaseVersion?: string;
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
  homeRedirect?: boolean;
  metaTitle?: string;
  metaDescription?: string;
  /** Keep the page out of search results (404). Also drops canonical and hreflang links. */
  noindex?: boolean;
}

const {
  page,
  locale,
  text,
  releaseVersion = '',
  jsonLd,
  homeRedirect = false,
  metaTitle,
  metaDescription,
  noindex = false,
} = Astro.props;

const site = Astro.site ?? new URL('https://kiji.yomilab.app');
const meta = text.pageMeta[page];
const title = metaTitle ?? meta.title;
const description = metaDescription ?? (page === 'download'
  ? formatVersionedCopy(meta.description, releaseVersion)
  : meta.description);
const canonicalPath = meta.canonicalPath;
const canonicalUrl = new URL(localePath(locale, canonicalPath), site).href;
const alternates = LANGUAGE_OPTIONS.map((option) => ({
  code: option.code,
  href: new URL(localePath(option.code, canonicalPath), site).href,
}));
const defaultLocaleUrl = new URL(localePath(DEFAULT_LANGUAGE_CODE, canonicalPath), site).href;
// 1200x630 previews built from the logo and a real capture by scripts/make-social-image.mjs.
const ogImage = new URL(`/images/og/kiji-og-${locale}.png`, site).href;
const ogLocale = OG_LOCALES[locale];
const ogLocaleAlternates = LANGUAGE_OPTIONS
  .map((option) => OG_LOCALES[option.code])
  .filter((value) => value !== ogLocale);
const jsonLdItems = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const shouldRedirectHome = homeRedirect && locale === DEFAULT_LANGUAGE_CODE;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        <link rel="canonical" href={canonicalUrl} />
        {alternates.map((alternate) => <link rel="alternate" hreflang={alternate.code} href={alternate.href} />)}
        <link rel="alternate" hreflang="x-default" href={defaultLocaleUrl} />
      </>
    )}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="KiJi updates" href="/feed.xml" />
    <meta property="og:site_name" content="KiJi" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={text.seo.ogImageAlt} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />
    {ogLocaleAlternates.map((value) => <meta property="og:locale:alternate" content={value} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={text.seo.ogImageAlt} />
    <meta name="theme-color" content="#EEE5D3" />
    <style is:inline set:html={readerThemeCss()} />
    <script is:inline define:vars={{ storageKey: SITE_THEME_STORAGE_KEY, defaultTheme: DEFAULT_SITE_THEME, themeIds: THEME_IDS }}>
      // The site wears the reader theme picked on the home page. Runs before
      // paint so every page opens in the saved theme without a flash.
      (function () {
        var root = document.documentElement;
        var media = window.matchMedia('(prefers-color-scheme: dark)');
        var saved = {};
        try {
          saved = JSON.parse(localStorage.getItem(storageKey) || '{}') || {};
        } catch (error) {
          saved = {};
        }
        function apply(theme, scheme) {
          if (themeIds.indexOf(theme) < 0) theme = defaultTheme;
          if (scheme !== 'light' && scheme !== 'dark') scheme = null;
          saved = { theme: theme, scheme: scheme };
          root.setAttribute('data-reader-theme', theme);
          root.setAttribute('data-scheme', scheme || (media.matches ? 'dark' : 'light'));
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', getComputedStyle(root).getPropertyValue('--rt-page').trim());
          document.dispatchEvent(new CustomEvent('kiji:reader-theme', { detail: { theme: theme, scheme: root.getAttribute('data-scheme') } }));
        }
        window.kijiReaderTheme = {
          get: function () {
            return { theme: root.getAttribute('data-reader-theme'), scheme: root.getAttribute('data-scheme') };
          },
          set: function (theme, scheme) {
            apply(theme, scheme);
            try {
              localStorage.setItem(storageKey, JSON.stringify(saved));
            } catch (error) {
              /* storage unavailable: the choice lasts for this page only */
            }
          },
        };
        apply(saved.theme, saved.scheme);
        if (media.addEventListener) {
          media.addEventListener('change', function () {
            if (!saved.scheme) apply(saved.theme, null);
          });
        }
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300..600;1,6..72,300..500&family=Inter:wght@400..650&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet" />
    {jsonLdItems.map((item) => <script is:inline type="application/ld+json" set:html={JSON.stringify(item)} />)}
    {shouldRedirectHome && (
      <script is:inline define:vars={{ storageKey: LANGUAGE_STORAGE_KEY }}>
        (function () {
          try {
            var lang = localStorage.getItem(storageKey);
            if (lang !== 'en' && lang !== 'zh-Hans' && lang !== 'ja') {
              var langs = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language];
              lang = 'en';
              for (var i = 0; i < langs.length; i += 1) {
                var candidate = String(langs[i] || '').toLowerCase();
                if (candidate.indexOf('zh') === 0) { lang = 'zh-Hans'; break; }
                if (candidate.indexOf('ja') === 0) { lang = 'ja'; break; }
              }
              localStorage.setItem(storageKey, lang);
            }
            if (lang !== 'en') {
              location.replace('/' + lang + '/');
            }
          } catch (error) {
            /* localStorage unavailable — stay on the English page */
          }
        })();
      </script>
    )}
  </head>
  <body>
    <Header locale={locale} text={text} canonicalPath={canonicalPath} />
    <slot />
    <Footer locale={locale} text={text} />
    <script is:inline define:vars={{ storageKey: LANGUAGE_STORAGE_KEY }}>
      // Persist the explicit language choice so the home page can honor it on the next visit.
      document.addEventListener('click', (event) => {
        const target = event.target instanceof Element ? event.target.closest('[data-language-choice]') : null;
        if (!target) return;
        try {
          localStorage.setItem(storageKey, target.getAttribute('data-language-choice') ?? 'en');
        } catch (error) {
          /* ignore */
        }
      });

      // Close open <details> menus (language, download options) on outside click.
      document.addEventListener('pointerdown', (event) => {
        document.querySelectorAll('details[open]').forEach((element) => {
          if (event.target instanceof Node && !element.contains(event.target)) {
            element.removeAttribute('open');
          }
        });
      });
    </script>
  </body>
</html>
